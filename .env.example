# auto: google.script.run when served by Apps Script, else the URL below, else sample data.
# gas | http | mock force one transport.
VITE_API_MODE=auto

# Deployed Apps Script web app URL (ends in /exec). Leave empty when served via HtmlService.
VITE_APPS_SCRIPT_URL=

# SHA-256 hex of each role password. Generate with: npm run hash-password -- "<password>"
# Or from Settings > كلمات المرور inside the app.
VITE_ROLE_HASH_APPROVER=
VITE_ROLE_HASH_DEVELOPER=
VITE_ROLE_HASH_ADMIN=
