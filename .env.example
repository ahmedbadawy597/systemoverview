# nest = Ministry NestJS API (recommended)
# auto | gas | http | mock kept for legacy Apps Script flows
VITE_API_MODE=nest

# Nest API base including /v1
VITE_API_BASE_URL=http://localhost:3000/v1

# Legacy Apps Script (only when VITE_API_MODE is gas/http/auto without Nest)
VITE_APPS_SCRIPT_URL=

# Legacy shared role password hashes (unused with Nest account auth)
VITE_ROLE_HASH_APPROVER=
VITE_ROLE_HASH_DEVELOPER=
VITE_ROLE_HASH_ADMIN=
